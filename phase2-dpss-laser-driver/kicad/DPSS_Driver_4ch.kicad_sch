	(text "Safety: ENABLE = key AND interlock AND TEMP_OK AND watchdog, latched; gates all channels in hardware."
		(exclude_from_sim no)
		(at 25.4 254 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "89ea954a-f120-45ed-9c58-a48308fbb56b")
	)
	(text "Rails: +12 V in; +5 V (buck); -5 V (charge pump); LAS_NEG = -3.3 V (inverting, >= 2 A); +3V3 from Pico; VREF_LIM 2.5 V."
		(exclude_from_sim no)
		(at 25.4 248.92 0)
